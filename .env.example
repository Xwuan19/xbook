# Cổng thanh toán PayOS (Lấy tại https://my.payos.vn/)
PAYOS_CLIENT_ID=your_client_id_here
PAYOS_API_KEY=your_api_key_here
PAYOS_CHECKSUM_KEY=your_checksum_key_here

# Mật khẩu quản trị viên (Xem thống kê và chốt sổ nhận sách)
ADMIN_PASSWORD=123456

# Phiên đăng nhập quản trị: ghi nhớ bao nhiêu ngày để không phải nhập lại mật khẩu
ADMIN_SESSION_DAYS=30
# Khóa ký token phiên (tùy chọn). Để trống = dùng luôn ADMIN_PASSWORD.
# Đổi giá trị này (hoặc đổi ADMIN_PASSWORD) là mọi phiên cũ hết hiệu lực.
ADMIN_SESSION_SECRET=

# Cấu hình máy chủ
PORT=3000
BASE_URL=http://localhost:3000

# Neon PostgreSQL Database (Lưu trữ đơn hàng vĩnh viễn trên đám mây)
DATABASE_URL=postgresql://username:password@ep-xyz-pooler.neon.tech/neondb?sslmode=require
